@* Jeder sieht die Bereiche, für die seine Rolle berechtigt ist *@ 
<MudNavMenu>

<AuthorizeView Roles="@($"{Rollen.Service},{Rollen.Administration}")">
    <MudNavLink Href="service" Icon="@Icons.Material.Filled.RoomService">
        Service
    </MudNavLink>
</AuthorizeView>

<AuthorizeView Roles="@($"{Rollen.Bar},{Rollen.Administration}")">
    <MudNavLink Href="bar" Icon="@Icons.Material.Filled.LocalBar">
        Bar
    </MudNavLink>
</AuthorizeView>

<AuthorizeView Roles="@Rollen.Administration">
    <MudNavGroup Title="Admin"
                 Icon="@Icons.Material.Filled.AdminPanelSettings"
                 Expanded="true">

        <MudNavLink Href="admin/artikel"
                    Icon="@Icons.Material.Filled.RestaurantMenu">
            Artikel
        </MudNavLink>

        <MudNavLink Href="admin/tische"
                    Icon="@Icons.Material.Filled.TableBar">
            Tische
        </MudNavLink>

        <MudNavLink Href="admin/mitarbeiter"
                    Icon="@Icons.Material.Filled.People">
            Mitarbeiter
        </MudNavLink>

        <MudNavLink Href="admin/statistik"
                    Icon="@Icons.Material.Filled.BarChart">
            Statistik
        </MudNavLink>

    </MudNavGroup>
</AuthorizeView>


</MudNavMenu>
