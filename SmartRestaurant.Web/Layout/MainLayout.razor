@inherits LayoutComponentBase
@inject AnmeldeStatusProvider AnmeldeStatus
@inject NavigationManager Navigation

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Orbit</MudText>
        <MudSpacer />
        <AuthorizeView>
            <MudText Class="mr-4">
                @context.User.Identity?.Name (@RolleVon(context.User))
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                       StartIcon="@Icons.Material.Filled.Logout" OnClick="Abmelden">
                Abmelden
            </MudButton>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="2" Variant="DrawerVariant.Persistent">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private static string? RolleVon(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

    private async Task Abmelden()
    {
        await AnmeldeStatus.AbmeldenAsync();
        Navigation.NavigateTo("/login", replace: true);
    }
}
