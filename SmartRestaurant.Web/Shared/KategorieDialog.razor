@inject HttpClient Http
@inject ISnackbar Snackbar
@using System.Net.Http.Json
@using SmartRestaurant.Shared.Dtos

<MudDialog>
    
<DialogContent>

    <MudStack Spacing="3" Style="min-width:350px">

        <MudTextField @bind-Value="Name"
                      Label="Kategoriename"
                      Required="true"
                      AutoFocus="true"
                      Variant="Variant.Outlined"
                      Placeholder="z. B. Getränke" />

    </MudStack>

</DialogContent>

<DialogActions>

    <MudButton OnClick="Abbrechen">
        Abbrechen
    </MudButton>

    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               OnClick="Speichern">

        Kategorie hinzufügen

    </MudButton>

</DialogActions>

</MudDialog>

@code {
    
[CascadingParameter]
private IMudDialogInstance MudDialog { get; set; } = null!;

private string Name { get; set; } = "";

private void Abbrechen()
{
    MudDialog.Cancel();
}

private async Task Speichern()
{
    var name = Name.Trim();

    if (string.IsNullOrWhiteSpace(name))
    {
        Snackbar.Add(
            "Bitte einen Kategorienamen eingeben.",
            Severity.Warning);

        return;
    }

    var dto = new NeueKategorieDto
    {
        Name = name
    };

    try
    {
        var antwort =
            await Http.PostAsJsonAsync(
                "api/kategorien",
                dto);

        if (antwort.IsSuccessStatusCode)
        {
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }

        var fehlertext =
            await antwort.Content.ReadAsStringAsync();

        if (antwort.StatusCode ==
            System.Net.HttpStatusCode.Conflict)
        {
            Snackbar.Add(
                "Diese Kategorie existiert bereits. Bitte wähle einen anderen Namen.",
                Severity.Warning);
        }
        else
        {
            Snackbar.Add(
                string.IsNullOrWhiteSpace(fehlertext)
                    ? "Kategorie konnte nicht angelegt werden."
                    : fehlertext,
                Severity.Error);
        }
    }
    catch (HttpRequestException)
    {
        Snackbar.Add(
            "Der Server konnte nicht erreicht werden.",
            Severity.Error);
    }
    catch (Exception ex)
    {
        Snackbar.Add(
            $"Fehler beim Anlegen der Kategorie: {ex.Message}",
            Severity.Error);
    }
}


}
