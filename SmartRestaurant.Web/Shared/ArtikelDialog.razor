@inject HttpClient Http
@inject ISnackbar Snackbar
@using SmartRestaurant.Shared.Dtos

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:350px">
            <MudTextField @bind-Value="Name" Label="Name" Required="true" />
            <MudNumericField @bind-Value="Preis" Label="Preis" Format="F2" Min="0" Required="true" Adornment="Adornment.End" AdornmentText="€" />
            <MudSelect T="int" @bind-Value="KategorieId" Label="Kategorie" Required="true">
                @foreach (var k in Kategorien)
                {
                    <MudSelectItem Value="@k.KategorieId">@k.Name</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Abbrechen">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Speichern">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public List<KategorieOption> Kategorien { get; set; } = new();
    [Parameter] public int? BearbeiteArtikelId { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public decimal Preis { get; set; }
    [Parameter] public int AusgewaehlteKategorieId { get; set; }

    private int KategorieId { get; set; }

    protected override void OnInitialized()
    {
        KategorieId = AusgewaehlteKategorieId;
    }

    private void Abbrechen() => MudDialog.Cancel();

    private async Task Speichern()
    {
        if (string.IsNullOrWhiteSpace(Name))
        {
            Snackbar.Add("Name darf nicht leer sein.", Severity.Warning);
            return;
        }
        if (KategorieId == 0)
        {
            Snackbar.Add("Bitte eine Kategorie auswählen.", Severity.Warning);
            return;
        }

        var dto = new NeuerArtikelDto { Name = Name, Preis = Preis, KategorieId = KategorieId };

        try
        {
            HttpResponseMessage antwort;
            if (BearbeiteArtikelId is int id)
                antwort = await Http.PutAsJsonAsync($"api/artikel/{id}", dto);
            else
                antwort = await Http.PostAsJsonAsync("api/artikel", dto);

            if (antwort.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var fehlertext = await antwort.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(fehlertext) ? "Speichern fehlgeschlagen." : fehlertext, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
    }

    public class KategorieOption
    {
        public int KategorieId { get; set; }
        public string Name { get; set; } = "";
    }
}