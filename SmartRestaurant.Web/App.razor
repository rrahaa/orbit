<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @* Jede Seite ist per [Authorize] (siehe _Imports.razor) gesperrt, außer sie hat [AllowAnonymous] *@
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <RedirectToStartseite />
                }
            </NotAuthorized>
            <Authorizing>
                <p class="p-4">Anmeldung wird geprüft...</p>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Nicht gefunden</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Seite nicht gefunden.</p>
        </LayoutView>
    </NotFound>
</Router>