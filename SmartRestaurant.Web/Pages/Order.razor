@page "/order"
@inject HttpClient Http

<PageTitle>Bestellung | Smart Restaurant</PageTitle>

<div class="order-shell">
    <header class="app-header">
        <div>
            <p class="eyebrow">SMART RESTAURANT</p>
            <h1>Bestellung aufnehmen</h1>
        </div>

        <div class="login-assignment">
            <span class="login-label">Mitarbeiter</span>
            <strong>Zuordnung später über Login</strong>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="message error-message">
            <strong>Verbindung fehlgeschlagen.</strong>
            <span>@errorMessage</span>
            <button @onclick="LoadData">Erneut versuchen</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="message success-message">@successMessage</div>
    }

    <div class="order-layout">
        <section class="panel tables-panel">
            <div class="panel-heading">
                <div>
                    <span class="section-label">BEREICH</span>
                    <h2>Tische</h2>
                </div>
                <span class="table-count">@tables.Count</span>
            </div>

            @if (isLoading)
            {
                <p class="muted">Tische werden geladen…</p>
            }
            else if (tables.Count == 0)
            {
                <p class="muted">Keine Tische verfügbar.</p>
            }
            else
            {
                <div class="table-list">
                    @foreach (var table in tables.OrderBy(x => x.Tischnummer))
                    {
                        <button class="table-card @(selectedTable?.TischId == table.TischId ? "selected" : "")"
                                @onclick="() => SelectTable(table)">
                            <span class="status-dot @(table.TischStatusId == 1 ? "free" : "occupied")"></span>
                            <span class="table-name">Tisch @table.Tischnummer</span>
                            <span class="table-meta">@table.Kapazitaet Plätze</span>
                            <span class="table-status">@(table.TischStatusId == 1 ? "frei" : "besetzt")</span>
                        </button>
                    }
                </div>
            }
        </section>

        <section class="panel products-panel">
            <div class="panel-heading products-heading">
                <div>
                    <span class="section-label">SORTIMENT</span>
                    <h2>Produkte</h2>
                </div>
                <div class="product-filters">
                    <select class="category-select" @bind="selectedCategory">
                        <option value="">Alle Kategorien</option>
                        @foreach (var category in Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                    <input class="search-input" @bind="searchText" @bind:event="oninput" placeholder="Produkt suchen…" />
                </div>
            </div>

            @if (isLoading)
            {
                <p class="muted">Produkte werden geladen…</p>
            }
            else if (products.Count == 0)
            {
                <p class="muted">Keine Produkte verfügbar.</p>
            }
            else
            {
                @foreach (var group in FilteredProducts.GroupBy(x => x.Kategorie).OrderBy(x => x.Key))
                {
                    <div class="category-block">
                        <h3>@group.Key</h3>
                        <div class="product-grid">
                            @foreach (var product in group)
                            {
                                <button class="product-card" @onclick="() => AddProduct(product)">
                                    <span class="product-name">@product.Name</span>
                                    <span class="product-price">@product.Preis.ToString("0.00") €</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </section>

        <aside class="panel cart-panel">
            <div class="panel-heading">
                <div>
                    <span class="section-label">AKTUELL</span>
                    <h2>@(selectedTable is null ? "Bestellung" : $"Tisch {selectedTable.Tischnummer}")</h2>
                </div>
                @if (cart.Count > 0)
                {
                    <button class="clear-button" @onclick="ClearCart">Leeren</button>
                }
            </div>

            @if (selectedTable is null)
            {
                <div class="empty-state">
                    <span class="empty-icon">1</span>
                    <strong>Tisch auswählen</strong>
                    <p>Wähle links zuerst einen Tisch aus.</p>
                </div>
            }
            else if (cart.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon">2</span>
                    <strong>Produkte hinzufügen</strong>
                    <p>Klicke auf ein Produkt, um es zur Bestellung hinzuzufügen.</p>
                </div>
            }
            else
            {
                <div class="cart-items">
                    @foreach (var item in cart)
                    {
                        <div class="cart-item">
                            <div class="cart-item-info">
                                <strong>@item.Product.Name</strong>
                                <span>@item.Product.Preis.ToString("0.00") € / Stück</span>
                            </div>

                            <div class="quantity-controls">
                                <button @onclick="() => Decrease(item)">−</button>
                                <span>@item.Quantity</span>
                                <button @onclick="() => Increase(item)">+</button>
                            </div>

                            <strong class="line-total">@((item.Product.Preis * item.Quantity).ToString("0.00")) €</strong>
                        </div>
                    }
                </div>
            }

            <div class="cart-footer">
                <div class="total-row">
                    <span>Gesamt</span>
                    <strong>@Total.ToString("0.00") €</strong>
                </div>

                <button class="submit-button"
                        disabled="@(selectedTable is null || cart.Count == 0 || isSubmitting)"
                        @onclick="SubmitOrder">
                    @(isSubmitting ? "Wird gesendet…" : "Bestellung senden")
                </button>
            </div>
        </aside>
    </div>
</div>

@code {
    private readonly List<CartItem> cart = new();
    private List<ArtikelDto> products = new();
    private List<TischUebersichtDto> tables = new();
    private TischUebersichtDto? selectedTable;
    private const int FallbackEmployeeId = 1; // TODO: später durch Mitarbeiter-ID aus dem Login ersetzen.
    private string selectedCategory = string.Empty;
    private string searchText = string.Empty;
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = true;
    private bool isSubmitting;

    private IEnumerable<string> Categories =>
        products.Select(x => x.Kategorie)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x);

    private IEnumerable<ArtikelDto> FilteredProducts =>
        products.Where(x =>
            (string.IsNullOrWhiteSpace(selectedCategory) ||
             x.Kategorie.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(searchText) ||
             x.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             x.Kategorie.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

    private decimal Total => cart.Sum(x => x.Product.Preis * x.Quantity);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var productTask = Http.GetFromJsonAsync<List<ArtikelDto>>("api/artikel");
            var tableTask = Http.GetFromJsonAsync<List<TischUebersichtDto>>("api/tische");

            await Task.WhenAll(productTask!, tableTask!);

            products = await productTask ?? new();
            tables = await tableTask ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = "Die API oder Datenbank ist nicht erreichbar. Prüfe, ob SmartRestaurant.Api läuft und die Datenbank-Verbindungsdaten in SmartRestaurant.Api/appsettings.json stimmen. " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectTable(TischUebersichtDto table)
    {
        selectedTable = table;
        successMessage = null;
    }

    private void AddProduct(ArtikelDto product)
    {
        successMessage = null;
        var existing = cart.FirstOrDefault(x => x.Product.ArtikelId == product.ArtikelId);

        if (existing is null)
        {
            cart.Add(new CartItem { Product = product, Quantity = 1 });
        }
        else
        {
            existing.Quantity++;
        }
    }

    private static void Increase(CartItem item) => item.Quantity++;

    private void Decrease(CartItem item)
    {
        item.Quantity--;
        if (item.Quantity <= 0)
        {
            cart.Remove(item);
        }
    }

    private void ClearCart()
    {
        cart.Clear();
        successMessage = null;
    }

    private async Task SubmitOrder()
    {
        if (selectedTable is null || cart.Count == 0)
            return;

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var dto = new NeueBestellungDto
            {
                TischId = selectedTable.TischId,
                MitarbeiterId = FallbackEmployeeId,
                Positionen = cart.Select(x => new NeueBestellPositionDto
                {
                    ArtikelId = x.Product.ArtikelId,
                    Menge = x.Quantity
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync("api/bestellungen", dto);

            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                errorMessage = $"Bestellung konnte nicht gespeichert werden ({(int)response.StatusCode}). {details}";
                return;
            }

            var tableNumber = selectedTable.Tischnummer;
            cart.Clear();
            successMessage = $"Bestellung für Tisch {tableNumber} wurde erfolgreich gespeichert.";

            // Reload tables so the selected table immediately changes to "besetzt".
            tables = await Http.GetFromJsonAsync<List<TischUebersichtDto>>("api/tische") ?? new();
            selectedTable = tables.FirstOrDefault(x => x.TischId == selectedTable.TischId);
        }
        catch (Exception ex)
        {
            errorMessage = "Beim Senden der Bestellung ist ein Fehler aufgetreten. " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class CartItem
    {
        public ArtikelDto Product { get; set; } = new();
        public int Quantity { get; set; }
    }
}
