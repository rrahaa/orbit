@page "/rechnung"
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@using System.Security.Claims

<PageTitle>Rechnung | Smart Restaurant</PageTitle>

<div class="billing-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">SMART RESTAURANT</p>
            <h1>Rechnung & Tischabschluss</h1>
            <p class="subtitle">Bestellungen prüfen, als serviert markieren und bezahlen.</p>
        </div>

    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="message error-message">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="message success-message">@successMessage</div>
    }

    <div class="billing-layout">
        <section class="panel table-panel">
            <div class="panel-heading">
                <div>
                    <span class="section-label">TISCHE</span>
                    <h2>Auswählen</h2>
                </div>
                <span class="count-badge">@tables.Count</span>
            </div>

            @if (isLoading)
            {
                <p class="muted">Tische werden geladen…</p>
            }
            else if (tables.Count == 0)
            {
                <p class="muted">Keine Tische verfügbar.</p>
            }
            else
            {
                <div class="table-list">
                    @foreach (var table in tables.OrderBy(x => x.Tischnummer))
                    {
                        <button class="table-card @(selectedTable?.TischId == table.TischId ? "selected" : "")"
                                @onclick="() => SelectTable(table)">
                            <span class="status-dot @(table.TischStatusId == 1 ? "free" : "occupied")"></span>
                            <span class="table-name">Tisch @table.Tischnummer</span>
                            <span class="table-meta">@table.Kapazitaet Plätze</span>
                            <span class="table-status">@(table.TischStatusId == 1 ? "frei" : "besetzt")</span>
                        </button>
                    }
                </div>
            }
        </section>

        <section class="panel invoice-panel">
            <div class="panel-heading invoice-heading">
                <div>
                    <span class="section-label">RECHNUNG</span>
                    <h2>@(selectedTable is null ? "Tisch auswählen" : $"Tisch {selectedTable.Tischnummer}")</h2>
                </div>
                @if (selectedTable is not null && unpaidOrders.Count > 0)
                {
                    <span class="open-badge">@unpaidOrders.Count offen</span>
                }
            </div>

            @if (selectedTable is null)
            {
                <div class="empty-state">
                    <strong>Kein Tisch ausgewählt</strong>
                    <p>Wähle links einen Tisch aus, um dessen Bestellungen und Rechnung zu sehen.</p>
                </div>
            }
            else if (isLoadingOrders)
            {
                <p class="muted">Bestellungen werden geladen…</p>
            }
            else if (orders.Count == 0)
            {
                <div class="empty-state">
                    <strong>Keine Bestellungen</strong>
                    <p>Für diesen Tisch wurden noch keine Bestellungen gefunden.</p>
                </div>
            }
            else
            {
                <div class="orders-list">
                    @foreach (var order in orders.OrderByDescending(x => x.Bestelldatum))
                    {
                        <article class="order-card @(IsPaid(order) ? "paid" : "")">
                            <div class="order-head">
                                <div>
                                    <strong>Bestellung #@order.BestellungId</strong>
                                    <span>@order.Bestelldatum.ToString("dd.MM.yyyy HH:mm") · @order.MitarbeiterName</span>
                                </div>
                                <span class="status-pill @StatusCss(order)">@order.Status</span>
                            </div>

                            <div class="positions">
                                @foreach (var pos in order.Positionen)
                                {
                                    <div class="position-row">
                                        <span>@pos.Menge × @pos.ArtikelName</span>
                                        <span>@pos.Summe.ToString("0.00") €</span>
                                    </div>
                                }
                            </div>

                            <div class="order-footer">
                                <strong>@order.Gesamtsumme.ToString("0.00") €</strong>
                                @if (!IsPaid(order))
                                {
                                    <div class="order-actions">
                                        @if (!IsServed(order))
                                        {
                                            <button class="served-button"
                                                    disabled="@isUpdating"
                                                    @onclick="() => SetStatus(order, 4)">
                                                Als serviert markieren
                                            </button>
                                        }
                                        <button class="paid-button"
                                                disabled="@isUpdating"
                                                @onclick="() => SetStatus(order, 5)">
                                            Als bezahlt markieren
                                        </button>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>

                <div class="invoice-summary">
                    <div>
                        <span>Offener Rechnungsbetrag</span>
                        <strong>@OpenTotal.ToString("0.00") €</strong>
                    </div>
                    <button class="pay-all-button"
                            disabled="@(unpaidOrders.Count == 0 || isUpdating)"
                            @onclick="PayAll">
                        Alle offenen Bestellungen bezahlen
                    </button>
                    @if (unpaidOrders.Count == 0)
                    {
                        <p class="paid-hint">Alle Bestellungen dieses Tisches sind bezahlt.</p>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    private List<TischUebersichtDto> tables = new();
    private List<BestellungDto> orders = new();
    private List<BestellungDto> unpaidOrders => orders.Where(x => !IsPaid(x)).ToList();

    private TischUebersichtDto? selectedTable;
    private int? mitarbeiterId;
    private bool isLoading = true;
    private bool isLoadingOrders;
    private bool isUpdating;
    private string? errorMessage;
    private string? successMessage;

    private decimal OpenTotal => unpaidOrders.Sum(x => x.Gesamtsumme);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        mitarbeiterId = int.TryParse(idClaim, out var id) ? id : null;

        await LoadTables();
    }

    private async Task LoadTables()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            tables = await Http.GetFromJsonAsync<List<TischUebersichtDto>>("api/tische") ?? new();

            if (selectedTable is not null)
            {
                selectedTable = tables.FirstOrDefault(x => x.TischId == selectedTable.TischId);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Tische konnten nicht geladen werden. " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectTable(TischUebersichtDto table)
    {
        selectedTable = table;
        successMessage = null;
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        if (selectedTable is null)
            return;

        isLoadingOrders = true;
        errorMessage = null;
        try
        {
            orders = await Http.GetFromJsonAsync<List<BestellungDto>>($"api/bestellungen/tisch/{selectedTable.TischId}") ?? new();
        }
        catch (Exception ex)
        {
            orders = new();
            errorMessage = "Bestellungen konnten nicht geladen werden. " + ex.Message;
        }
        finally
        {
            isLoadingOrders = false;
        }
    }

    private async Task SetStatus(BestellungDto order, int statusId)
    {
        if (mitarbeiterId is null)
        {
            errorMessage = "Kein angemeldeter Mitarbeiter gefunden. Bitte erneut anmelden.";
            return;
        }

        isUpdating = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/bestellungen/{order.BestellungId}/status",
                new StatusAendernDto { NeuerStatusId = statusId, MitarbeiterId = mitarbeiterId.Value });

            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                errorMessage = $"Status konnte nicht geändert werden ({(int)response.StatusCode}). {details}";
                return;
            }

            successMessage = statusId == 4
                ? $"Bestellung #{order.BestellungId} wurde als serviert markiert."
                : $"Bestellung #{order.BestellungId} wurde als bezahlt markiert.";

            await LoadOrders();
            await LoadTables();
        }
        catch (Exception ex)
        {
            errorMessage = "Status konnte nicht geändert werden. " + ex.Message;
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task PayAll()
    {
        if (mitarbeiterId is null)
        {
            errorMessage = "Kein angemeldeter Mitarbeiter gefunden. Bitte erneut anmelden.";
            return;
        }

        if (unpaidOrders.Count == 0)
            return;

        isUpdating = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            foreach (var order in unpaidOrders.ToList())
            {
                var response = await Http.PutAsJsonAsync(
                    $"api/bestellungen/{order.BestellungId}/status",
                    new StatusAendernDto { NeuerStatusId = 5, MitarbeiterId = mitarbeiterId.Value });

                if (!response.IsSuccessStatusCode)
                {
                    var details = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Bestellung #{order.BestellungId} konnte nicht bezahlt werden ({(int)response.StatusCode}). {details}";
                    return;
                }
            }

            successMessage = "Alle offenen Bestellungen wurden bezahlt. Der Tisch wird freigegeben, sobald keine unbezahlte Bestellung mehr vorhanden ist.";
            await LoadOrders();
            await LoadTables();
        }
        catch (Exception ex)
        {
            errorMessage = "Die Rechnung konnte nicht abgeschlossen werden. " + ex.Message;
        }
        finally
        {
            isUpdating = false;
        }
    }

    private static bool IsPaid(BestellungDto order) =>
        order.Status.Equals("Bezahlt", StringComparison.OrdinalIgnoreCase);

    private static bool IsServed(BestellungDto order) =>
        order.Status.Equals("Serviert", StringComparison.OrdinalIgnoreCase);

    private static string StatusCss(BestellungDto order)
    {
        if (IsPaid(order)) return "status-paid";
        if (IsServed(order)) return "status-served";
        return "status-open";
    }
}