@page "/admin/artikel"
@inject HttpClient Http
@using SmartRestaurant.Shared.Dtos

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">Artikel</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OeffneNeu">
            Neuer Artikel
        </MudButton>
    </MudStack>

    @if (artikel is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudTable Items="@artikel" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Preis</MudTh>
                <MudTh>Kategorie</MudTh>
                <MudTh Style="width:100px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Preis.ToString("0.00") €</MudTd>
                <MudTd>@context.Kategorie</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OeffneBearbeiten(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Loeschen(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<ArtikelDto>? artikel;
    private List<ArtikelDialog.KategorieOption> kategorien = new();

    protected override async Task OnInitializedAsync()
    {
        await LadeDaten();
    }

    private async Task LadeDaten()
    {
        try
        {
            artikel = await Http.GetFromJsonAsync<List<ArtikelDto>>("api/artikel");
            kategorien = await Http.GetFromJsonAsync<List<ArtikelDialog.KategorieOption>>("api/kategorien") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler beim Laden: {ex.Message}", Severity.Error);
            artikel = new();
        }
    }

    private async Task OeffneNeu()
    {
        var parameter = new DialogParameters
        {
            ["Kategorien"] = kategorien
        };
        var dialog = await DialogService.ShowAsync<ArtikelDialog>("Neuer Artikel", parameter);
        var ergebnis = await dialog.Result;

        if (ergebnis is { Canceled: false })
            await LadeDaten();
    }

    private async Task OeffneBearbeiten(ArtikelDto a)
    {
        var parameter = new DialogParameters
        {
            ["Kategorien"] = kategorien,
            ["BearbeiteArtikelId"] = a.ArtikelId,
            ["Name"] = a.Name,
            ["Preis"] = a.Preis,
            ["AusgewaehlteKategorieId"] = a.KategorieId
        };
        var dialog = await DialogService.ShowAsync<ArtikelDialog>("Artikel bearbeiten", parameter);
        var ergebnis = await dialog.Result;

        if (ergebnis is { Canceled: false })
            await LadeDaten();
    }

    private async Task Loeschen(ArtikelDto a)
    {
        try
        {
            var antwort = await Http.DeleteAsync($"api/artikel/{a.ArtikelId}");
            if (antwort.IsSuccessStatusCode)
            {
                Snackbar.Add($"{a.Name} gelöscht.", Severity.Success);
                await LadeDaten();
            }
            else
            {
                var fehlertext = await antwort.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(fehlertext) ? "Löschen fehlgeschlagen." : fehlertext, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
    }

    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
}