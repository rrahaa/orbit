@page "/admin/statistik"
@inject HttpClient Http
@using SmartRestaurant.Shared.Dtos

<MudText Typo="Typo.h4" Class="mb-4">Statistik</MudText>

@if (statistik is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Wochenumsatz</MudText>
                <MudText Typo="Typo.h3">@statistik.Wochenumsatz.ToString("0.00") €</MudText>
                <MudText Typo="Typo.caption">letzte 7 Tage, nur abgeschlossene Bestellungen (ab „Fertig“)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Meistverkauftes Getränk</MudText>
                @if (statistik.MeistverkauftesGetraenk is null)
                {
                    <MudText Typo="Typo.h5">Keine Verkäufe</MudText>
                }
                else
                {
                    <MudText Typo="Typo.h3">@statistik.MeistverkauftesGetraenk</MudText>
                    <MudText Typo="Typo.caption">@statistik.MeistverkaufteMenge mal verkauft</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LadeDaten" Class="mt-4">
    Aktualisieren
</MudButton>

@code {
    private StatistikDto? statistik;

    protected override async Task OnInitializedAsync()
    {
        await LadeDaten();
    }

    private async Task LadeDaten()
    {
        try
        {
            statistik = await Http.GetFromJsonAsync<StatistikDto>("api/statistik/woche");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler beim Laden: {ex.Message}", Severity.Error);
        }
    }

    [Inject] private ISnackbar Snackbar { get; set; } = null!;
}