@page "/admin/mitarbeiter"
@inject HttpClient Http
@using SmartRestaurant.Shared.Dtos

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">Mitarbeiter</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OeffneNeu">
            Neuer Mitarbeiter
        </MudButton>
    </MudStack>

    @if (mitarbeiter is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudTable Items="@mitarbeiter" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Benutzername</MudTh>
                <MudTh>Rolle</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="width:100px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Benutzername</MudTd>
                <MudTd>@context.Rolle</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(context.IstAktiv ? Color.Success : Color.Default)" Size="Size.Small">
                        @(context.IstAktiv ? "aktiv" : "deaktiviert")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OeffneBearbeiten(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Loeschen(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<MitarbeiterDto>? mitarbeiter;
    private List<MitarbeiterDialog.RolleOption> rollen = new();

    protected override async Task OnInitializedAsync()
    {
        await LadeDaten();
    }

    private async Task LadeDaten()
    {
        try
        {
            mitarbeiter = await Http.GetFromJsonAsync<List<MitarbeiterDto>>("api/mitarbeiter");
            rollen = await Http.GetFromJsonAsync<List<MitarbeiterDialog.RolleOption>>("api/rollen") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler beim Laden: {ex.Message}", Severity.Error);
            mitarbeiter = new();
        }
    }

    private async Task OeffneNeu()
    {
        var parameter = new DialogParameters
        {
            ["Rollen"] = rollen
        };
        var dialog = await DialogService.ShowAsync<MitarbeiterDialog>("Neuer Mitarbeiter", parameter);
        var ergebnis = await dialog.Result;

        if (ergebnis is { Canceled: false })
            await LadeDaten();
    }

    private async Task OeffneBearbeiten(MitarbeiterDto m)
    {
        var rolleId = rollen.FirstOrDefault(r => r.Name == m.Rolle)?.RolleId ?? 0;

        var parameter = new DialogParameters
        {
            ["Rollen"] = rollen,
            ["BearbeiteMitarbeiterId"] = m.MitarbeiterId,
            ["Name"] = m.Name,
            ["Benutzername"] = m.Benutzername,
            ["AusgewaehlteRolleId"] = rolleId
        };
        var dialog = await DialogService.ShowAsync<MitarbeiterDialog>("Mitarbeiter bearbeiten", parameter);
        var ergebnis = await dialog.Result;

        if (ergebnis is { Canceled: false })
            await LadeDaten();
    }

    private async Task Loeschen(MitarbeiterDto m)
    {
        try
        {
            var antwort = await Http.DeleteAsync($"api/mitarbeiter/{m.MitarbeiterId}");
            if (antwort.IsSuccessStatusCode)
            {
                Snackbar.Add($"{m.Name} deaktiviert.", Severity.Success);
                await LadeDaten();
            }
            else
            {
                var fehlertext = await antwort.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(fehlertext) ? "Löschen fehlgeschlagen." : fehlertext, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
    }

    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
}