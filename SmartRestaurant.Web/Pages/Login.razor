@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]

@inject HttpClient Http
@inject NavigationManager Navigation
@inject AnmeldeStatusProvider AnmeldeStatus

<PageTitle>Login - Smart Gastro</PageTitle>

<div class="login-card">

    <h1>Smart Gastro</h1>
    <h2>Anmeldung</h2>

    <EditForm Model="login" OnValidSubmit="Anmelden">

        <div class="form-group">
            <label for="benutzername">Benutzername</label>
            <InputText id="benutzername"
                       class="form-control"
                       autocomplete="username"
                       @bind-Value="login.Benutzername" />
        </div>

        <div class="form-group">
            <label for="passwort">Passwort</label>
            <InputText id="passwort"
                       class="form-control"
                       type="password"
                       autocomplete="current-password"
                       @bind-Value="login.Passwort" />
        </div>

        @if (!string.IsNullOrEmpty(fehler))
        {
            <div class="fehler">
                @fehler
            </div>
        }

        <button type="submit" class="login-button" disabled="@laedt">
            @(laedt ? "Bitte warten..." : "Anmelden")
        </button>

    </EditForm>

</div>

@code {

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private LoginDto login = new();
    private string fehler = string.Empty;
    private bool laedt;

    protected override async Task OnInitializedAsync()
    {
        // Bereits angemeldet -> direkt auf die eigene Seite
        var benutzer = (await AuthState).User;
        if (benutzer.Identity?.IsAuthenticated == true)
        {
            var ziel = Rollen.Startseite(benutzer.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value);

            if (ziel == "/login")
            {
                // Unbekannte Rolle -> Sitzung verwerfen, sonst Weiterleitungsschleife
                await AnmeldeStatus.AbmeldenAsync();
                return;
            }

            Navigation.NavigateTo(ziel, replace: true);
        }
    }

    private async Task Anmelden()
    {
        fehler = string.Empty;

        if (string.IsNullOrWhiteSpace(login.Benutzername) || string.IsNullOrWhiteSpace(login.Passwort))
        {
            fehler = "Bitte Benutzername und Passwort eingeben.";
            return;
        }

        laedt = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/login", login);

            if (!response.IsSuccessStatusCode)
            {
                fehler = "Benutzername oder Passwort ist falsch.";
                return;
            }

            var benutzer =
                await response.Content.ReadFromJsonAsync<LoginAntwortDto>();

            if (benutzer == null)
            {
                fehler = "Fehler beim Anmelden.";
                return;
            }

            var ziel = Rollen.Startseite(benutzer.Rolle);

            if (ziel == "/login")
            {
                fehler = $"Für die Rolle \"{benutzer.Rolle}\" gibt es keine Seite.";
                return;
            }

            await AnmeldeStatus.AnmeldenAsync(benutzer);
            Navigation.NavigateTo(ziel, replace: true);
        }
        catch (HttpRequestException)
        {
            fehler = "Verbindung zum Server fehlgeschlagen.";
        }
        catch (Exception)
        {
            fehler = "Fehler beim Anmelden.";
        }
        finally
        {
            laedt = false;
        }
    }
}
